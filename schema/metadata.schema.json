{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SF Express HK Metadata Schema",
  "type": "object",
  "required": [
    "schema_version",
    "retrieved_at",
    "counts",
    "count_deltas",
    "source_status",
    "coverage",
    "quality"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [2] },
    "retrieved_at": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "required": ["total", "stores", "lockers", "partners"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "stores": { "type": "integer", "minimum": 0 },
        "lockers": { "type": "integer", "minimum": 0 },
        "partners": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "count_deltas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["previous", "current", "delta", "delta_pct", "baseline_available", "baseline_source", "gate_result"],
        "properties": {
          "previous": { "type": ["integer", "null"] },
          "current": { "type": "integer" },
          "delta": { "type": "integer" },
          "delta_pct": { "type": "number" },
          "baseline_available": { "type": "boolean" },
          "baseline_source": { "type": "string" },
          "gate_result": { "type": "string", "enum": ["pass", "warn", "block"] }
        },
        "additionalProperties": false
      }
    },
    "source_status": {
      "type": "object",
      "required": ["api_tc", "api_en", "ssr", "partner_pdf"],
      "properties": {
        "api_tc": {
          "type": "object",
          "required": ["areas_total", "areas_success", "areas_failed"],
          "properties": {
            "areas_total": { "type": "integer", "minimum": 0 },
            "areas_success": { "type": "integer", "minimum": 0 },
            "areas_failed": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "api_en": {
          "type": "object",
          "required": ["areas_total", "areas_success", "areas_failed"],
          "properties": {
            "areas_total": { "type": "integer", "minimum": 0 },
            "areas_success": { "type": "integer", "minimum": 0 },
            "areas_failed": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "ssr": {
          "type": "object",
          "required": ["count", "errors"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "errors": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "partner_pdf": {
          "type": "object",
          "required": ["pdf_total", "pdf_success", "pdf_failed", "status", "records", "errors"],
          "properties": {
            "pdf_total": { "type": "integer", "minimum": 0 },
            "pdf_success": { "type": "integer", "minimum": 0 },
            "pdf_failed": { "type": "integer", "minimum": 0 },
            "status": { "type": "string", "enum": ["success", "no_pdfs_discovered", "all_pdfs_failed", "partial_pdf_failures", "zero_records_parsed", "partial_parse_quality_failure"] },
            "records": { "type": "integer", "minimum": 0 },
            "errors": { "type": "array", "items": { "type": "string" } },
            "details": { "type": "array" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "tc_record_count",
        "en_record_count",
        "bilingual_match_rate",
        "district_resolved_count",
        "district_unresolved_count"
      ],
      "properties": {
        "tc_record_count": { "type": "integer", "minimum": 0 },
        "en_record_count": { "type": "integer", "minimum": 0 },
        "bilingual_match_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "district_resolved_count": { "type": "integer", "minimum": 0 },
        "district_unresolved_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": [
        "pipeline_blocking_errors",
        "pipeline_warnings",
        "record_flag_counts_by_severity",
        "flag_counts_by_type"
      ],
      "properties": {
        "pipeline_blocking_errors": { "type": "integer", "minimum": 0 },
        "pipeline_warnings": { "type": "integer", "minimum": 0 },
        "record_flag_counts_by_severity": {
          "type": "object",
          "required": ["info", "warning", "error"],
          "properties": {
            "info": { "type": "integer", "minimum": 0 },
            "warning": { "type": "integer", "minimum": 0 },
            "error": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "flag_counts_by_type": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
